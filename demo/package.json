{
  "name": "@primeinc/storyscroller-demo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:production": "NODE_ENV=production vite build",
    "clean": "rimraf dist .turbo .vite-cache",
    "dev": "vite --port 5184",
    "preview": "vite preview --port 4173",
    "preview:production": "vite build && vite preview",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --cache --fix",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:unit": "vitest run",
    "test:unit:run": "vitest run",
    "test:all": "npm run test:unit:run && npm run test",
    "test:e2e": "playwright test",
    "quality": "npm run lint && npm run typecheck && npm run build",
    "predeploy": "vite build --base=/StoryScroller/",
    "deploy": "gh-pages -d dist",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod",
    "deploy:github": "node scripts/deploy-github-pages.js",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@primeinc/storyscroller": "workspace:../package",
    "@vitejs/plugin-react": "^4.2.1",
    "gsap": "^3.12.5",
    "lenis": "^1.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^8.44.0",
    "autoprefixer": "^10.4.19",
    "cssnano": "^6.0.1",
    "eslint": "^8.57.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.5",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.8.3",
    "vitest": "^1.4.0"
  }
}