{
  "name": "storyscroller",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "StoryScroller React component and demo extracted from portfolio monorepo",
  "author": "Prime Inc",
  "license": "MIT",
  "engines": {
    "node": ">=20.17.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --filter @primeinc/storyscroller-demo",
