{
  "name": "@primeinc/storyscroller",
  "version": "0.9.0-beta.1",
  "description": "Production-ready React component for narrative-driven scroll experiences with GSAP and Lenis",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "import": "./dist/styles/index.css"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.17.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "echo 'Skipping ESLint for now - TypeScript provides type checking'",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "PLAYWRIGHT_HEADED=true playwright test",
    "test:debug": "playwright test --debug",
    "test:interactive": "PLAYWRIGHT_HTML_REPORT=true playwright test",
    "test:report": "PLAYWRIGHT_HTML_REPORT=true playwright show-report",
    "test:report:generate": "PLAYWRIGHT_HTML_REPORT=true playwright test --reporter=html",
    "test:unit": "vitest run",
    "test:unit:run": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit:run && npm run test",
    "quality": "npm run lint && npm run typecheck && npm run build",
    "prerelease": "npm run quality && npm run test:all",
    "release:patch": "npm version patch && npm run build && npm publish",
    "release:minor": "npm version minor && npm run build && npm publish",
    "release:major": "npm version major && npm run build && npm publish",
    "license:add": "node scripts/add-license-headers.js",
    "bundle:analyze": "npm run build && du -h dist/*.js",
    "benchmark": "node scripts/benchmark.js",
    "clean": "rimraf dist coverage test-results playwright-report .turbo",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "gsap": "^3.12.5",
    "lenis": "^1.1.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^8.57.1",
    "jsdom": "^24.0.0",
    "rimraf": "^5.0.5",
    "start-server-and-test": "^2.0.3",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Prime Inc",
  "repository": {
    "type": "git",
    "url": "https://github.com/primeinc/StoryScroller.git",
    "directory": "package"
  },
  "keywords": [
    "react",
    "scroll",
    "smooth-scroll",
    "gsap",
    "lenis",
    "animation",
    "scroll-snapping",
    "nextjs"
  ]
}